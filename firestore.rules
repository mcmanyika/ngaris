rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 1–3: server-only via Admin SDK (API routes).
    // No client SDK read/write for leads, profiles, providers, or projects.

    match /leads/{leadId} {
      allow read, write: if false;
    }

    match /profiles/{uid} {
      allow read, write: if false;
    }

    match /providers/{providerId} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
